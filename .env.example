# Copy this file to .env and replace EVERY placeholder below.
# .env is gitignored — never commit real secrets.
#
# The values here are deliberately INVALID placeholders, not usable defaults.
# Generate a real value for each one with the command documented above it.

# ── Database ──────────────────────────────────────────────────────────────────
# Must match docker-compose.yml when using `make dev-up`
# (user/db default to nat_backup, password to nat_backup_dev).
DATABASE_URL=postgres://REPLACE_USER:REPLACE_PASSWORD@localhost:5432/nat_backup?sslmode=disable

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs the JWTs handed to the web UI. Random base64 string, min 32 bytes.
# Generate with:
#   openssl rand -base64 32
JWT_SECRET=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_32

# AES-256-GCM key used to encrypt storage configs and backup passphrases at
# rest. MUST be exactly 64 hex characters (32 bytes).
# Generate with:
#   openssl rand -hex 32
#
# WARNING: rotating this key makes every already-encrypted storage destination
# config and backup passphrase in the database unreadable.
ENCRYPTION_KEY=REPLACE_ME_GENERATE_WITH_openssl_rand_hex_32

# Password for the built-in admin user, set on first startup.
# Generate a strong one with:
#   openssl rand -base64 24
ADMIN_PASSWORD=REPLACE_ME_GENERATE_WITH_openssl_rand_base64_24

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080

# ── TLS (optional) ───────────────────────────────────────────────────────────
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=
